# ============================================================
# TOSUMO Backend — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- Core ----
# NODE_ENV: development | production
NODE_ENV=production
# PORT: report to Railway / your platform
PORT=3000
# HOST: 0.0.0.0 required so Railway can expose the service
HOST=0.0.0.0
# Public URLs used in email links. Set to the deployed backend/frontend.
API_URL=https://your-backend.up.railway.app
APP_URL=https://tosumo.cm

# ---- Database (MongoDB Atlas) ----
# Required. The ONLY database the backend connects to.
DATABASE_URL=your_mongodb_atlas_connection_string

# ---- JWT ----
# Strong random secrets. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Encryption ----
# Used to encrypt sensitive fields. Strong random secret.
ENCRYPTION_KEY=replace_with_strong_secret

# ---- SMTP / Email (optional) ----
# Leave blank to disable email delivery. Backend still starts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tosumo.cm

# ---- SMS / OTP ----
# OTP_MODE=demo accepts any 6-digit code (investor demo, no real SMS).
# OTP_MODE=provider delivers real SMS via Africa's Talking once the keys are set.
OTP_MODE=demo
# Africa's Talking (only used when OTP_MODE=provider).
SMS_API_KEY=
SMS_USERNAME=
# Demo-only: ignored in demo mode (any 6-digit code is accepted).
DEMO_OTP=123456

# ---- Demo patient account (optional) ----
# Used by `npm run seed:demo` and the demo login.
DEMO_PATIENT_PHONE=+237691234567
DEMO_PATIENT_PASSWORD=Demo@1234
DEMO_PATIENT_EMAIL=demo@tosumo.cm
DEMO_PATIENT_NIN=NIN-DEMO-1985-0314-001

# ---- Payments ----
# mock | (future: orangemoney | mtnmomo | stripe). mock = no real credentials.
PAYMENT_PROVIDER=mock

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---- Socket.IO ----
SOCKET_PATH=/ws

# ---- CORS ----
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=https://your-backend.up.railway.app,https://tosumo.cm